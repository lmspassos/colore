---
interface Props {
  type?: string;
}
const { type = 'instituicao' } = Astro.props;
const types = [
  ['instituicao', 'Quero receber a exposição'],
  ['educador', 'Sou educador(a)'],
  ['outro', 'Outro assunto'],
];
---

<form name="contato" method="POST" action="/obrigado" data-netlify="true" netlify-honeypot="bot-field">
  <input type="hidden" name="form-name" value="contato" />
  <p class="hp"><label>Não preencha: <input name="bot-field" /></label></p>

  <p>
    <label for="tipo">Tipo de contato</label>
    <select id="tipo" name="tipo" required>
      {types.map(([v, l]) => <option value={v} selected={v === type}>{l}</option>)}
    </select>
  </p>
  <p><label for="nome">Nome</label><input id="nome" name="nome" required autocomplete="name" /></p>
  <p><label for="email">E-mail</label><input id="email" name="email" type="email" required autocomplete="email" /></p>
  <p><label for="instituicao">Instituição (se houver)</label><input id="instituicao" name="instituicao" /></p>
  <p><label for="mensagem">Mensagem</label><textarea id="mensagem" name="mensagem" rows="5" required></textarea></p>
  <p class="consent">
    <input id="lgpd" name="lgpd" type="checkbox" required />
    <label for="lgpd">Li e concordo com a <a href="/privacidade">política de privacidade</a>.</label>
  </p>
  <button class="button" type="submit">Enviar</button>
</form>

<style>
  form {
    display: grid;
    gap: var(--space-1);
    max-width: 36rem;
  }
  p {
    margin: 0 0 var(--space-1);
  }
  label {
    display: block;
    font-weight: 600;
  }
  input:not([type='checkbox']),
  select,
  textarea {
    width: 100%;
    padding: 0.6rem 0.8rem;
    border: 3px solid var(--graphite);
    border-radius: var(--radius);
    background: #fff;
    color: var(--graphite);
    font: inherit;
  }
  .consent {
    display: flex;
    gap: var(--space-1);
    align-items: flex-start;
  }
  .consent input {
    width: 1.5rem;
    height: 1.5rem;
    flex: none;
    margin-top: 0.2rem;
  }
  .consent label {
    font-weight: 400;
  }
  .hp {
    position: absolute;
    left: -9999px;
  }
  button {
    justify-self: start;
  }
</style>
