---
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const links = [
  ['/a-exposicao', 'A exposição'],
  ['/para-instituicoes', 'Para instituições'],
  ['/para-educadores', 'Para educadores'],
  ['/sobre', 'Sobre'],
  ['/contato', 'Contato'],
];
---

<header>
  <div class="container bar">
    <a href="/" class="brand">Colorê</a>
    <nav aria-label="Principal">
      <ul>
        {
          links.map(([href, label]) => (
            <li>
              <a href={href} aria-current={path === href ? 'page' : undefined}>
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  header {
    border-bottom: 3px solid var(--graphite);
  }
  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    padding-block: var(--space-2);
  }
  .brand {
    font: 700 2rem var(--font-title);
    text-decoration: none;
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* página atual: sublinhado grosso (forma, não só cor) */
  [aria-current='page'] {
    font-weight: 700;
    text-decoration: underline 3px;
  }
</style>
